rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'created_at']);
      allow update: if signedInAs(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email']);
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read, delete: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && request.resource.data.keys().hasOnly([
            'description', 'amount', 'type', 'category', 'date', 'created_at'
          ])
          && request.resource.data.description is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.category is string
          && request.resource.data.date is string
          && request.resource.data.created_at is timestamp;
        allow update: if signedInAs(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'description', 'amount', 'type', 'category', 'date'
          ])
          && request.resource.data.description is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.category is string
          && request.resource.data.date is string;
      }

      match /budgets/{category} {
        allow read, delete: if signedInAs(userId);
        allow create, update: if signedInAs(userId)
          && request.resource.data.keys().hasOnly([
            'category', 'amount_limit', 'period', 'created_at'
          ])
          && request.resource.data.category == category
          && request.resource.data.amount_limit is number
          && request.resource.data.amount_limit > 0
          && request.resource.data.period == 'monthly'
          && request.resource.data.created_at is timestamp;
      }
    }
  }
}
